# ================================================================
#  DailyJob (कामसाथी) - FastAPI Backend Environment Configuration
#  DEDICATED FIREBASE PROJECT: dailyjob-platform
# ================================================================

# Application Settings
ENVIRONMENT=development
PORT=8001
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001

# NEW DailyJob Firebase Project Configuration
# IMPORTANT: Create a new project in Firebase Console named 'dailyjob-platform'
# DO NOT reuse credentials from any other project!
FIREBASE_PROJECT_ID=dailyjob-platform
FIREBASE_STORAGE_BUCKET=dailyjob-platform.appspot.com

# Service Account Credentials:
# Option 1 (Recommended for local dev): Path to service account JSON file relative to backend root
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Option 2 (Recommended for containerized/cloud deployments): Minified JSON string
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"dailyjob-platform",...}

# Proximity Threshold for Attendance Check-In (in meters, e.g., 500m)
ATTENDANCE_PROXIMITY_METERS=500.0

# Mock/Local Fallback Mode for offline testing without cloud credentials
USE_FIREBASE_MOCK_FALLBACK=true
