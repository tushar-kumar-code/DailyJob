# ================================================================
#  CGNeeti (कामसाथी) - Environment Variables Template
# ================================================================

# Server Configuration
PORT=8000
NODE_ENV=development

# Authentication Secret (Used for HMAC-SHA256 JWT signing - min 32 characters)
AUTH_SECRET=replace-with-a-secure-random-secret-key-in-production

# Google OAuth 2.0 Credentials (From Google Cloud Console)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create "OAuth Client ID" -> Application type "Web application"
# 3. Add Authorized JavaScript origins: http://localhost:8000
# 4. Add Authorized redirect URIs: http://localhost:8000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
